{
  "version": 2,
  "buildCommand": "bash build.sh",
  "builds": [
    {
      "src": "uni_portal/wsgi.py",
      "use": "@vercel/python@3.12"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/staticfiles/$1",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/(.*)",
      "dest": "uni_portal/wsgi.py"
    }
  ]
}