{
  "version": 2,
  "buildCommand": "bash build.sh",
  "env": {
    "PYTHONUNBUFFERED": "1",
    "VERCEL": "1",
    "DJANGO_SETTINGS_MODULE": "uni_portal.settings"
  },
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "^/(.*)$",
      "dest": "/api/index.py"
    }
  ]
}