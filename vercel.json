{
  "version": 2,
  "buildCommand": "bash build.sh",
  "env": {
    "PYTHONUNBUFFERED": "1",
    "VERCEL": "1",
    "DJANGO_SETTINGS_MODULE": "uni_portal.settings"
  },
  "functions": {
    "api/**/*.py": {
      "runtime": "python3.11",
      "includeFiles": "staticfiles/**"
    }
  },
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "api/wsgi.py"
    },
    {
      "src": "/(.*)",
      "dest": "api/wsgi.py"
    }
  ]
}