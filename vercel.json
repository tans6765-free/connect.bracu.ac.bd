{
  "version": 2,
  "buildCommand": "bash build.sh",
  "builds": [
    {
      "src": "uni_portal/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb"
      }
    }
  ],
  "env": {
    "PYTHONUNBUFFERED": "1",
    "VERCEL": "1",
    "DJANGO_SETTINGS_MODULE": "uni_portal.settings"
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "uni_portal/wsgi.py"
    }
  ]
}