{
  "version": 2,
  "buildCommand": "bash build.sh",
  "env": {
    "PYTHONUNBUFFERED": "1",
    "VERCEL": "1",
    "DJANGO_SETTINGS_MODULE": "uni_portal.settings"
  },
  "functions": {
    "uni_portal/wsgi.py": {
      "includeFiles": ["staticfiles/**"]
    }
  },
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "uni_portal/wsgi.py"
    },
    {
      "src": "/(.*)",
      "dest": "uni_portal/wsgi.py"
    }
  ]
}